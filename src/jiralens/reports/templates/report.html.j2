<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JiraLens report — {{ config.project_key }} — {{ result.scan_id }}</title>
<style>
  :root {
    --ink: #1a1d21; --muted: #5c6670; --line: #d8dde3; --bg: #ffffff;
    --panel: #f6f8fa; --high: #a4262c; --high-bg: #fdf3f3;
    --warn: #8a6100; --warn-bg: #fff9ec; --info: #0b5cab;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 32px; background: var(--bg); color: var(--ink);
    font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    max-width: 1100px;
  }
  h1 { font-size: 22px; margin: 0 0 4px; }
  h2 { font-size: 16px; margin: 32px 0 8px; padding-bottom: 6px; border-bottom: 2px solid var(--line); }
  h3 { font-size: 14px; margin: 20px 0 6px; color: var(--muted); font-weight: 600; }
  p { margin: 6px 0; }
  .sub { color: var(--muted); margin: 0 0 20px; }
  .readonly {
    display: inline-block; padding: 3px 9px; border-radius: 3px; font-size: 12px;
    background: #e8f3ec; color: #1d6b3c; font-weight: 600; margin-bottom: 16px;
  }
  .cards { display: flex; flex-wrap: wrap; gap: 12px; margin: 12px 0 4px; }
  .card {
    flex: 1 1 150px; border: 1px solid var(--line); border-radius: 5px;
    padding: 12px 14px; background: var(--panel);
  }
  .card .n { font-size: 26px; font-weight: 650; line-height: 1.1; }
  .card .l { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .card.high { background: var(--high-bg); border-color: #e7c3c5; }
  .card.high .n { color: var(--high); }
  .card.warn { background: var(--warn-bg); border-color: #e8d9ad; }
  .card.warn .n { color: var(--warn); }
  table { width: 100%; border-collapse: collapse; margin: 8px 0 4px; font-size: 13px; }
  th, td { text-align: left; padding: 7px 9px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { background: var(--panel); font-size: 12px; text-transform: uppercase; letter-spacing: .03em; color: var(--muted); }
  td.num, th.num { text-align: right; white-space: nowrap; }
  tbody tr:nth-child(even) { background: #fbfcfd; }
  .key { white-space: nowrap; font-weight: 600; }
  a { color: #0b5cab; }
  .sev { font-weight: 650; font-size: 12px; text-transform: uppercase; white-space: nowrap; }
  .sev-high { color: var(--high); }
  .sev-warning { color: var(--warn); }
  .sev-info { color: #0b5cab; }
  dl.meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 18px; margin: 8px 0; }
  dl.meta dt { color: var(--muted); }
  dl.meta dd { margin: 0; }
  code { background: var(--panel); padding: 1px 5px; border-radius: 3px; font-size: 12px; }
  ul.notes { margin: 6px 0; padding-left: 20px; }
  ul.notes li { margin: 5px 0; }
  .none { color: var(--muted); font-style: italic; }
  footer { margin-top: 36px; padding-top: 10px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  @media print {
    body { padding: 0; max-width: none; font-size: 11pt; }
    h2 { page-break-after: avoid; }
    table { page-break-inside: auto; }
    tr { page-break-inside: avoid; }
    a { color: var(--ink); text-decoration: none; }
  }
</style>
</head>
<body>

<h1>Project health report — {{ config.project_key }}</h1>
<p class="sub">{{ result.scan_id }} · generated {{ generated_local }} · source: {{ result.source_name }}</p>
<span class="readonly">Read-only scan — no change was made to Jira</span>

<h2>Executive summary</h2>
<div class="cards">
  <div class="card"><div class="n">{{ result.issue_count }}</div><div class="l">Issues scanned</div></div>
  <div class="card high"><div class="n">{{ counts.high }}</div><div class="l">High findings</div></div>
  <div class="card warn"><div class="n">{{ counts.warning }}</div><div class="l">Warnings</div></div>
  <div class="card"><div class="n">{{ flagged_count }}</div><div class="l">Issues flagged</div></div>
  <div class="card"><div class="n">{{ result.clean_issue_count }}</div><div class="l">Issues with no findings</div></div>
</div>
{% if counts.high %}
<p>
  {{ counts.high }} finding{{ '' if counts.high == 1 else 's' }} need attention first.
  {{ flagged_count }} of {{ result.issue_count }} open issues carry at least one finding.
</p>
{% else %}
<p>No high-severity findings. {{ flagged_count }} of {{ result.issue_count }} open issues carry a warning.</p>
{% endif %}

<h2>Scope and thresholds</h2>
<dl class="meta">
  <dt>Query</dt><dd><code>{{ config.effective_jql() }}</code></dd>
  <dt>Stale threshold</dt><dd>{{ config.stale_days }} calendar days</dd>
  <dt>High-priority stale threshold</dt><dd>{{ config.high_priority_stale_days }} calendar days</dd>
  <dt>Current-status age threshold</dt><dd>{{ config.status_age_days }} calendar days</dd>
  <dt>Priorities treated as high</dt><dd>{{ config.high_priorities | sort | join(', ') }}</dd>
  <dt>Statuses excluded from status age</dt>
  <dd>{% if config.excluded_statuses %}{{ config.excluded_statuses | sort | join(', ') }}{% else %}<span class="none">none</span>{% endif %}</dd>
  <dt>Display timezone</dt><dd>{{ config.timezone }}</dd>
  <dt>Status history retrieved</dt><dd>{{ 'yes' if config.include_changelog else 'no' }}</dd>
</dl>
{% if result.skipped_checks %}
<p><strong>Checks skipped:</strong> {{ result.skipped_checks | join(', ') }}. These were not evaluated,
so this report makes no statement about them — it is not a finding of zero.</p>
{% endif %}

{% macro findings_table(rows) %}
<table>
  <thead>
    <tr>
      <th>Severity</th><th>Check</th><th>Issue</th><th>Summary</th>
      <th>Assignee</th><th>Status</th><th class="num">Age</th><th>Reason</th>
    </tr>
  </thead>
  <tbody>
  {% for row in rows %}
    <tr>
      <td class="sev sev-{{ row.severity }}">{{ row.severity }}</td>
      <td>{{ row.check_name }}</td>
      <td class="key"><a href="{{ row.issue_url }}" target="_blank" rel="noopener noreferrer">{{ row.issue_key }}</a></td>
      <td>{{ row.summary }}</td>
      <td>{{ row.assignee }}</td>
      <td>{{ row.status }}</td>
      <td class="num">{% if row.age_days is not none %}{{ row.age_days }}d{% else %}—{% endif %}</td>
      <td>{{ row.reason }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endmacro %}

<h2>High-risk findings</h2>
{% if high_rows %}
{{ findings_table(high_rows) }}
{% else %}
<p class="none">No high-severity findings in this scan.</p>
{% endif %}

<h2>Warning findings</h2>
{% if warning_rows %}
{{ findings_table(warning_rows) }}
{% else %}
<p class="none">No warnings in this scan.</p>
{% endif %}

{% if info_rows %}
<h2>Informational findings</h2>
{{ findings_table(info_rows) }}
{% endif %}

<h2>Findings by check</h2>
{% if by_check %}
<table>
  <thead><tr><th>Check</th><th class="num">High</th><th class="num">Warning</th><th class="num">Total</th></tr></thead>
  <tbody>
  {% for name, c in by_check.items() %}
    <tr><td>{{ name }}</td><td class="num">{{ c.high }}</td><td class="num">{{ c.warning }}</td><td class="num">{{ c.total }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="none">No findings to group.</p>
{% endif %}

<h2>Findings by assignee</h2>
{% if by_assignee %}
<table>
  <thead><tr><th>Assignee</th><th class="num">High</th><th class="num">Warning</th><th class="num">Total</th></tr></thead>
  <tbody>
  {% for name, c in by_assignee.items() %}
    <tr><td>{{ name }}</td><td class="num">{{ c.high }}</td><td class="num">{{ c.warning }}</td><td class="num">{{ c.total }}</td></tr>
  {% endfor %}
  </tbody>
</table>
<p class="sub">Grouped to show where work is concentrated, not to rank individuals. Unassigned
work appears as its own row and is usually the first thing to fix.</p>
{% else %}
<p class="none">No findings to group.</p>
{% endif %}

<h2>Methodology</h2>
{% for check_id, name in check_names.items() %}
<h3>{{ name }}</h3>
<p>{{ check_descriptions[check_id] }}
{% if check_id in result.skipped_checks %}<strong>Not evaluated in this scan.</strong>{% endif %}
</p>
{% endfor %}
<h3>How ages are counted</h3>
<ul class="notes">
{% for note in methodology_notes %}
  <li>{{ note }}</li>
{% endfor %}
</ul>

<h2>Limitations</h2>
<ul class="notes">
{% for item in limitations %}
  <li>{{ item }}</li>
{% endfor %}
</ul>
{% if result.warnings %}
<h3>Notes recorded during this scan</h3>
<ul class="notes">
{% for warning in result.warnings %}
  <li>{{ warning }}</li>
{% endfor %}
</ul>
{% endif %}

<h2>Scan metadata</h2>
<dl class="meta">
  <dt>Scan ID</dt><dd>{{ result.scan_id }}</dd>
  <dt>Project</dt><dd>{{ config.project_key }}</dd>
  <dt>Started</dt><dd>{{ result.started_at.isoformat() }}</dd>
  <dt>Completed</dt><dd>{{ result.completed_at.isoformat() }}</dd>
  <dt>Elapsed</dt><dd>{{ '%.2f' | format(result.duration_seconds) }} seconds</dd>
  <dt>Issues scanned</dt><dd>{{ result.issue_count }}</dd>
  <dt>Findings</dt><dd>{{ result.finding_count }}</dd>
  <dt>Source</dt><dd>{{ result.source_name }}</dd>
</dl>

<footer>
  Produced by JiraLens — a read-only Jira Cloud project health auditor.
  This report contains no credentials, and no issue descriptions, comments,
  attachments or worklogs were retrieved to build it.
</footer>

</body>
</html>

# Copy to .env and fill in locally. NEVER commit .env.
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# Do not pass the token on the command line: shell history retains it.

JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your.name@company.com
JIRA_API_TOKEN=replace-with-local-token
JIRA_DEFAULT_PROJECT=DEMO

JIRALENS_TIMEZONE=Africa/Lusaka
JIRALENS_LOG_LEVEL=INFO

# Demo mode runs the full audit engine against synthetic data, no Jira needed.
JIRALENS_DEMO_MODE=false

# Set true on any public deployment to hard-disable live Jira access.
JIRALENS_LIVE_JIRA_DISABLED=false
